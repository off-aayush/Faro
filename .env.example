# Required for semantic search and chat (embedding generation)
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Required for chat and agent features (LLM calls)
GROQ_API_KEY=your_groq_api_key_here

# Optional — URL for Qdrant vector database (default: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# Optional — LangSmith tracing (Phase 2 feature)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key_here
# LANGCHAIN_PROJECT=faro

# Get your FREE Groq key (no credit card) at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Get your Voyage AI key at: https://dash.voyageai.com/
VOYAGE_API_KEY=your_key_here

# Qdrant URL (defaults to http://localhost:6333 if running via Docker)
QDRANT_URL=http://localhost:6333

# How to run:
# node src/index.js ./src          <- without AI
# node src/index.js ./src --ai     <- with AI summaries (requires GROQ_API_KEY)
